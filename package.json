{
  "name": "pt-swipe-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pt-swipe/web",
    "build": "npm run build -w @pt-swipe/web",
    "start": "npm run start -w @pt-swipe/web",
    "lint": "npm run lint -w @pt-swipe/web",
    "typecheck": "npm run typecheck -w @pt-swipe/shared"
  }
}
